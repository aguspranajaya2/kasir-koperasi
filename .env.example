NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/koperasi?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=15m
SALES_TAX_RATE_BPS=0
SALES_BUSINESS_TIMEZONE=Asia/Makassar
COOKIE_DOMAIN=
COOKIE_SECURE=false
LOG_LEVEL=info
# Docker stack UI settings. Defaults work for local access at http://localhost:8080.
WEB_PORT=8080
DOCKER_WEB_ORIGIN=http://localhost:8080
# Set these locally before the first seed:admin command. Do not commit real credentials.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
